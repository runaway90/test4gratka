{% extends 'base.html.twig' %}

{% block title %}
    An Error Occurred
{% endblock %}

{% block body %}
    <div class="container text-center mt-5">
        <h1 class="display-4">Oops! Something went wrong.</h1>

        <p class="lead">
            We are sorry, but an unexpected error occurred.
            Our team has been notified and we are working to fix it.
        </p>

        <p>
            Error: {{ status_code }} {{ status_text }}
        </p>

        <a href="{{ path('home') }}" class="btn btn-primary">
            Go to Homepage
        </a>
    </div>
{% endblock %}
